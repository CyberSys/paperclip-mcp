# paperclip-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Paperclip base URL. "/api" is appended automatically when missing.
# Default: http://localhost:3100   (PAPERCLIP_BASE_URL is still accepted as an alias)
PAPERCLIP_API_URL=http://localhost:3100

# Bearer token. Two kinds exist:
#   - BOARD API key (pcp_board_...): full operator access — approve/reject, pause/resume
#     agents, budgets, attention feed, decisions, checkout on behalf of any agent.
#     Mint one with `paperclipai login` (CLI) or POST /api/board-api-keys, or via the
#     create_board_api_key tool on a local_trusted instance.
#   - AGENT API key (Paperclip UI → agent → API keys): agent-scoped. Board-only tools
#     return 403 and checkout/release need a real run id.
# Leave empty ONLY for local_trusted deployments (requests then act as the local board).
PAPERCLIP_API_KEY=

# Required — Company UUID to operate on.
# Find it in the Paperclip UI URL: http://localhost:3100/companies/{PAPERCLIP_COMPANY_ID}
# or with the list_companies tool (board key).
PAPERCLIP_COMPANY_ID=

# Optional — default agent UUID for checkout_issue when using a board key.
PAPERCLIP_AGENT_ID=

# Optional — forwarded as X-Paperclip-Run-Id on write requests. Only set it to a REAL
# heartbeat run id (e.g. when running inside a heartbeat); a made-up UUID breaks
# foreign keys server-side.
PAPERCLIP_RUN_ID=
